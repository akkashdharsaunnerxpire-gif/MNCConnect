<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'MNCConnect Admin' %></title>
    <link rel="stylesheet" href="/admin/css/output.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-slate-950 text-white min-h-screen">
    
    <!-- Sidebar -->
    <div class="flex h-screen">
        <aside class="w-64 bg-slate-900 border-r border-slate-800 fixed h-full overflow-y-auto">
            <div class="p-6 border-b border-slate-800">
                <h1 class="text-2xl font-bold text-indigo-500">MNCConnect</h1>
                <p class="text-sm text-slate-400">Admin Panel</p>
            </div>
            
            <nav class="p-4 space-y-2">
                <a href="/admin" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= currentPage === 'dashboard' ? 'bg-indigo-600' : '' %>">
                    <i class="fas fa-chart-pie w-5"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/admin/mentors" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= currentPage === 'mentors' ? 'bg-indigo-600' : '' %>">
                    <i class="fas fa-users w-5"></i>
                    <span>Mentors</span>
                </a>
                <a href="/admin/freshers" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= currentPage === 'freshers' ? 'bg-indigo-600' : '' %>">
                    <i class="fas fa-graduation-cap w-5"></i>
                    <span>Freshers</span>
                </a>
                <a href="/admin/payments" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= currentPage === 'payments' ? 'bg-indigo-600' : '' %>">
                    <i class="fas fa-credit-card w-5"></i>
                    <span>Payments</span>
                </a>
                <a href="/admin/users" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= currentPage === 'users' ? 'bg-indigo-600' : '' %>">
                    <i class="fas fa-user-cog w-5"></i>
                    <span>Users</span>
                </a>
                <a href="/admin/logout" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-red-600/20 text-red-400 transition mt-8">
                    <i class="fas fa-sign-out-alt w-5"></i>
                    <span>Logout</span>
                </a>
            </nav>
        </aside>
        
        <!-- Main Content -->
        <main class="ml-64 flex-1 p-8 overflow-y-auto">
            <div class="flex justify-between items-center mb-8">
                <div>
                    <h2 class="text-3xl font-bold text-white"><%= pageTitle || 'Dashboard' %></h2>
                    <p class="text-slate-400"><%= pageSubtitle || 'Welcome back, ' + (admin ? admin.name : 'Admin') %></p>
                </div>
                <div class="flex items-center gap-4">
                    <span class="text-slate-400"><i class="fas fa-user-circle text-2xl"></i> <%= admin ? admin.name : 'Admin' %></span>
                </div>
            </div>
            
            <!-- Page Content -->
            <%- body %>
        </main>
    </div>
    
    <script src="/admin/js/admin.js"></script>
</body>
</html>