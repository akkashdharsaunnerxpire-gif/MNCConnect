<%- include('partials/layout-start') %>

<%
  const tabs = [
    { k: 'all', l: 'All', c: counts.all },
    { k: 'pending', l: 'Pending', c: counts.pending },
    { k: 'approved', l: 'Approved', c: counts.approved },
    { k: 'rejected', l: 'Rejected', c: counts.rejected }
  ];
  const tabUrl = (k) => '/admin/mentors?' + new URLSearchParams({ status: k, search: search || '', sort: sort }).toString();
  const exportUrl = '/admin/mentors/export?' + new URLSearchParams({ status: status, search: search || '' }).toString();
%>

<div class="tabs">
    <% tabs.forEach(function (t) { %>
        <a href="<%= tabUrl(t.k) %>" class="<%= status === t.k ? 'active' : '' %>"><%= t.l %> <b><%= t.c %></b></a>
    <% }) %>
</div>

<div class="card mb">
    <div class="card-body" style="padding:16px 20px;">
        <form method="GET" action="/admin/mentors" class="filters">
            <input type="hidden" name="status" value="<%= status %>">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input class="input" type="text" name="search" value="<%= search %>"
                       placeholder="Search name, email, phone, company...  (press / )">
            </div>
            <select name="sort" class="select" data-autosubmit>
                <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest first</option>
                <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Oldest first</option>
                <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Name A–Z</option>
                <option value="experience" <%= sort === 'experience' ? 'selected' : '' %>>Most experienced</option>
            </select>
            <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i> Search</button>
            <a href="/admin/mentors" class="btn btn-ghost"><i class="fas fa-rotate-left"></i> Reset</a>
            <a href="<%= exportUrl %>" class="btn btn-ghost"><i class="fas fa-file-csv"></i> Export CSV</a>
        </form>
    </div>
</div>

<div class="card">
    <% if (mentors.length) { %>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Mentor</th>
                    <th>Contact</th>
                    <th>Experience</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th class="t-right">Actions</th>
                </tr>
            </thead>
            <tbody>
            <% mentors.forEach(function (m) { %>
                <tr>
                    <td>
                        <div class="cell-user">
                            <div class="av"><% if (m.profilePic) { %><img src="<%= m.profilePic %>" alt=""><% } else { %><%= (m.name || 'M').charAt(0).toUpperCase() %><% } %></div>
                            <div>
                                <b><%= m.name || 'Unnamed mentor' %></b>
                                <span class="muted small"><%= m.designation || '—' %><% if (m.currentCompany) { %> · <%= m.currentCompany %><% } %></span>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div><%= m.email || 'N/A' %></div>
                        <div class="muted small"><%= m.phone || ([m.countryCode, m.mobile].filter(Boolean).join(' ') || 'N/A') %></div>
                    </td>
                    <td class="muted"><%= m.yearsOfExperience != null ? m.yearsOfExperience + ' yrs' : '—' %></td>
                    <td><%- include('partials/status-badge', { st: m.status }) %></td>
                    <td class="muted small"><%= m.createdAt ? new Date(m.createdAt).toLocaleDateString('en-GB') : 'N/A' %></td>
                    <td>
                        <div class="row-actions">
                            <a href="/admin/mentors/<%= m._id %>" class="btn btn-ghost btn-sm"><i class="fas fa-eye"></i> View</a>
                        </div>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
    <%- include('partials/pagination') %>
    <% } else { %>
        <div class="empty">
            <i class="fas fa-user-slash"></i>
            <h4>No mentors found</h4>
            <p>Try adjusting your search or filter.</p>
        </div>
    <% } %>
</div>

<%- include('partials/layout-end') %>