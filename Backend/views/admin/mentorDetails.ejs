<%- include('partials/layout-start') %>

<%
  const safeUrl = (u) => (u && /^https?:\/\//i.test(String(u))) ? String(u) : '';
  const isImg = (u) => /\.(png|jpe?g|webp|gif)(\?|$)/i.test(String(u || ''));
  const dt = (d) => d ? new Date(d).toLocaleString('en-GB') : '—';
  const ago = (d) => {
    if (!d) return '';
    const days = Math.floor((Date.now() - new Date(d).getTime()) / 86400000);
    if (days < 1) return 'today';
    if (days === 1) return 'yesterday';
    if (days < 30) return days + ' days ago';
    const m = Math.floor(days / 30);
    if (m < 12) return m + ' month' + (m > 1 ? 's' : '') + ' ago';
    const y = Math.floor(days / 365);
    return y + ' year' + (y > 1 ? 's' : '') + ' ago';
  };
  const auditMeta = {
    login_success: ['fa-right-to-bracket', ''], login_failed: ['fa-ban', 'bad'],
    review_saved: ['fa-list-check', ''], mentor_approve: ['fa-circle-check', 'ok'],
    mentor_reject: ['fa-circle-xmark', 'bad'], mentor_pending: ['fa-rotate-left', 'warn'],
    bulk_reject: ['fa-circle-xmark', 'bad'], bulk_pending: ['fa-rotate-left', 'warn']
  };
  const auditText = {
    review_saved: 'Saved the verification checklist', mentor_approve: 'Approved the mentor',
    mentor_reject: 'Rejected the mentor', mentor_pending: 'Moved the mentor back to pending',
    bulk_reject: 'Rejected (bulk)', bulk_pending: 'Moved to pending (bulk)'
  };
%>

<% if (!mentor) { %>

    <div class="card empty">
        <i class="fas fa-user-slash"></i>
        <h4>Mentor not found</h4>
        <p>This mentor doesn't exist or has been removed.</p>
        <a href="/admin/mentors" class="btn btn-primary"><i class="fas fa-arrow-left"></i> Back to mentors</a>
    </div>

<% } else {
    const linkedin = safeUrl(mentor.linkedinProfile);
    const rawMobile = mentor.mobile ? String(mentor.mobile).trim() : '';
    const phone = rawMobile ? (rawMobile.startsWith('+') ? rawMobile : ((mentor.countryCode || '+91') + ' ' + rawMobile)) : '';
    const telHref = phone ? String(phone).replace(/[^\d+]/g, '') : '';

    // ---- Documents ----
    const docList = [
      { k: 'offerLetter', t: 'Offer letter', s: 'Employment document', i: 'fa-file-contract' },
      { k: 'employeeIdProof', t: 'Employee ID proof', s: 'Employee identification', i: 'fa-id-card' },
      { k: 'additionalProof', t: 'Additional proof', s: 'Supporting document', i: 'fa-file-circle-check' }
    ].map(function (d) {
      const url = safeUrl(mentor[d.k]);
      const ext = url ? (url.split('?')[0].split('.').pop() || '').toUpperCase() : '';
      return Object.assign({}, d, { url: url, img: isImg(url), type: (ext && ext.length <= 4) ? ext : 'FILE' });
    });
    const docsDone = docList.filter(function (d) { return d.url; }).length;
    const docsOk = !!docList[0].url && !!docList[1].url;

    // ---- Automatic signals (HINTS only. The admin decides.) ----
    const signals = [
      { t: 'Offer letter uploaded', tone: docList[0].url ? 'ok' : 'bad' },
      { t: 'Employee ID proof uploaded', tone: docList[1].url ? 'ok' : 'bad' },
      { t: 'Employee ID number provided', tone: mentor.employeeId ? 'ok' : 'bad', hint: mentor.employeeId || '' },
      { t: 'Work email domain', tone: emailInfo.tone, hint: emailInfo.text },
      { t: 'LinkedIn profile added', tone: linkedin ? 'ok' : 'warn', hint: linkedin ? '' : 'Optional but recommended' },
      { t: 'Duplicate check', tone: duplicates.length ? 'bad' : 'ok', hint: duplicates.length ? duplicates.length + ' possible duplicate account(s) found' : 'No other mentor shares these details' }
    ];
    const sigOk = signals.filter(function (x) { return x.tone === 'ok'; }).length;
    const sigBad = signals.some(function (x) { return x.tone === 'bad'; });
    const sigWarn = signals.some(function (x) { return x.tone === 'warn'; });
    const toneIcon = { ok: 'fa-circle-check', bad: 'fa-circle-xmark', warn: 'fa-triangle-exclamation' };

    // ---- Manual review progress ----
    const reqChecks = reviewChecks.filter(function (c) { return c.required; });
    const reqDone = reqChecks.filter(function (c) { return review.checks[c.key]; }).length;
    const reqPct = reqChecks.length ? Math.round((reqDone / reqChecks.length) * 100) : 0;
    const canApprove = review.complete && docsOk;

    // ---- Profile completeness ----
    const fields = [
      mentor.name, mentor.email, mentor.mobile, mentor.workEmail, mentor.employeeId, mentor.linkedinProfile,
      mentor.currentCompany, mentor.designation, mentor.department, mentor.yearsOfExperience != null,
      mentor.officeLocation, mentor.hourlyRate, mentor.bio, (mentor.languages && mentor.languages.length), mentor.profilePic
    ];
    const completeness = Math.round((fields.filter(Boolean).length / fields.length) * 100);
%>

<!-- Breadcrumb -->
<div class="md-crumb">
    <a href="/admin/mentors"><i class="fas fa-user-tie"></i> Mentors</a>
    <i class="fas fa-chevron-right sep"></i>
    <span class="cur"><%= mentor.name || 'Mentor' %></span>
</div>

<!-- Hero -->
<div class="card md-hero">
    <div class="md-cover st-<%= mentor.status %>"></div>
    <div class="md-hero-body">
        <div class="md-avatar">
            <% if (mentor.profilePic) { %><img src="<%= mentor.profilePic %>" alt="<%= mentor.name %>"><% } else { %><%= (mentor.name || '?').charAt(0).toUpperCase() %><% } %>
        </div>
        <div class="md-id">
            <h3><%= mentor.name || 'N/A' %> <%- include('partials/status-badge', { st: mentor.status }) %></h3>
            <div class="sub"><%= mentor.designation || 'Designation not provided' %><% if (mentor.currentCompany) { %> · <%= mentor.currentCompany %><% } %></div>
            <div class="md-meta">
                <% if (mentor.officeLocation) { %><span><i class="fas fa-location-dot"></i><%= mentor.officeLocation %></span><% } %>
                <% if (mentor.department) { %><span><i class="fas fa-sitemap"></i><%= mentor.department %></span><% } %>
                <span><i class="fas fa-calendar-check"></i>Registered <%= ago(mentor.createdAt) || '—' %></span>
                <% if (mentor.employeeId) { %><span><i class="fas fa-id-badge"></i>ID: <%= mentor.employeeId %></span><% } %>
            </div>
        </div>
    </div>
</div>

<!-- Duplicate warning -->
<% if (duplicates.length) { %>
<div class="dup-alert">
    <h4><i class="fas fa-triangle-exclamation"></i> Possible duplicate or conflicting accounts</h4>
    <ul>
        <% duplicates.forEach(function (d) { %>
            <li>
                <a href="/admin/mentors/<%= d._id %>"><%= d.name || d.email || 'Mentor' %></a>
                <span class="muted">(<%= d.status %>)</span>
                &mdash; <b><%= d.why.join(', ') %></b>
            </li>
        <% }) %>
    </ul>
</div>
<% } %>

<!-- Stat strip -->
<div class="md-stats">
    <div class="card md-stat t-primary"><small>Experience</small><b><%= mentor.yearsOfExperience != null ? mentor.yearsOfExperience : 0 %> <em>yrs</em></b></div>
    <div class="card md-stat t-ok"><small>Hourly rate</small><b><%= mentor.hourlyRate ? '₹' + Number(mentor.hourlyRate).toLocaleString('en-IN') : '—' %></b></div>
    <div class="card md-stat t-warn"><small>Documents</small><b><%= docsDone %><em> / <%= docList.length %></em></b></div>
    <div class="card md-stat t-info">
        <small>Profile complete</small><b><%= completeness %>%</b>
        <div class="progress"><i data-w="<%= completeness %>"></i></div>
    </div>
</div>

<div class="md-grid">

    <!-- ============ MAIN ============ -->
    <div>
        <div class="md-tabs">
            <button type="button" class="md-tab active" data-tab="overview"><i class="fas fa-user"></i> Overview</button>
            <button type="button" class="md-tab" data-tab="documents"><i class="fas fa-file-shield"></i> Documents <span class="badge <%= docsDone === docList.length ? 'b-ok' : 'b-warn' %>"><%= docsDone %>/<%= docList.length %></span></button>
            <button type="button" class="md-tab" data-tab="activity"><i class="fas fa-clock-rotate-left"></i> Activity</button>
        </div>

        <!-- Overview -->
        <div class="md-pane active" id="pane-overview">

            <!-- Quick checks (automatic hints) -->
            <div class="card">
                <div class="card-head">
                    <div class="sec-title t-info"><div class="sec-ico"><i class="fas fa-wand-magic-sparkles"></i></div>
                        <div><h3>Quick checks</h3><p>Automatic hints only. The final decision is yours.</p></div></div>
                    <span class="badge <%= sigBad ? 'b-bad' : (sigWarn ? 'b-warn' : 'b-ok') %>"><%= sigOk %>/<%= signals.length %> passed</span>
                </div>
                <div class="card-body">
                    <div class="qc-grid">
                        <% signals.forEach(function (s) { %>
                            <div class="qc <%= s.tone %>">
                                <i class="fas <%= toneIcon[s.tone] %>"></i>
                                <div><b><%= s.t %></b><% if (s.hint) { %><small><%= s.hint %></small><% } %></div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div class="sec-title t-primary"><div class="sec-ico"><i class="fas fa-user"></i></div>
                        <div><h3>Personal information</h3><p>Basic details and contact</p></div></div>
                    <div class="head-actions">
                        <% if (mentor.email) { %><a class="btn btn-ghost btn-sm" href="mailto:<%= mentor.email %>"><i class="fas fa-paper-plane"></i> Email</a><% } %>
                        <% if (phone) { %><a class="btn btn-ghost btn-sm" href="tel:<%= telHref %>"><i class="fas fa-phone-volume"></i> Call</a><% } %>
                        <% if (linkedin) { %><a class="btn btn-ghost btn-sm" href="<%= linkedin %>" target="_blank" rel="noopener noreferrer"><i class="fab fa-linkedin"></i> LinkedIn</a><% } %>
                    </div>
                </div>
                <div class="card-body">
                    <div class="info-grid">
                        <div class="info"><div class="k">Full name</div><div class="v"><%= mentor.name || 'Not provided' %></div></div>
                        <div class="info"><div class="k">Email</div><div class="v has-copy"><span><%= mentor.email || 'Not provided' %></span><% if (mentor.email) { %><button type="button" class="copy-btn" data-copy="<%= mentor.email %>" title="Copy"><i class="fas fa-copy"></i></button><% } %></div></div>
                        <div class="info"><div class="k">Mobile</div><div class="v has-copy"><span><%= phone || 'Not provided' %></span><% if (phone) { %><button type="button" class="copy-btn" data-copy="<%= phone %>" title="Copy"><i class="fas fa-copy"></i></button><% } %></div></div>
                        <div class="info"><div class="k">Work email</div><div class="v has-copy"><span><%= mentor.workEmail || 'Not provided' %></span><% if (mentor.workEmail) { %><button type="button" class="copy-btn" data-copy="<%= mentor.workEmail %>" title="Copy"><i class="fas fa-copy"></i></button><% } %></div></div>
                        <div class="info"><div class="k">Employee ID</div><div class="v has-copy"><span><%= mentor.employeeId || 'Not provided' %></span><% if (mentor.employeeId) { %><button type="button" class="copy-btn" data-copy="<%= mentor.employeeId %>" title="Copy"><i class="fas fa-copy"></i></button><% } %></div></div>
                        <div class="info"><div class="k">LinkedIn</div>
                            <div class="v"><% if (linkedin) { %><a href="<%= linkedin %>" target="_blank" rel="noopener noreferrer" class="link"><i class="fab fa-linkedin"></i> View profile</a><% } else { %>Not provided<% } %></div></div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div class="sec-title t-info"><div class="sec-ico"><i class="fas fa-briefcase"></i></div>
                        <div><h3>Professional information</h3><p>Current employment details</p></div></div>
                </div>
                <div class="card-body">
                    <div class="info-grid">
                        <div class="info"><div class="k">Company</div><div class="v"><%= mentor.currentCompany || 'Not provided' %></div></div>
                        <div class="info"><div class="k">Designation</div><div class="v"><%= mentor.designation || 'Not provided' %></div></div>
                        <div class="info"><div class="k">Department</div><div class="v"><%= mentor.department || 'Not provided' %></div></div>
                        <div class="info"><div class="k">Experience</div><div class="v"><%= mentor.yearsOfExperience != null ? mentor.yearsOfExperience : 0 %> years</div></div>
                        <div class="info"><div class="k">Office location</div><div class="v"><%= mentor.officeLocation || 'Not provided' %></div></div>
                        <div class="info"><div class="k">Hourly rate</div><div class="v"><%= mentor.hourlyRate ? '₹' + mentor.hourlyRate : 'Not specified' %></div></div>
                    </div>

                    <% if (mentor.languages && mentor.languages.length) { %>
                        <div class="langs">
                            <div class="label">Languages</div>
                            <div class="chips"><% mentor.languages.forEach(function (l) { %><span class="chip"><%= l %></span><% }) %></div>
                        </div>
                    <% } %>
                </div>
            </div>

            <% if (mentor.bio) { %>
            <div class="card">
                <div class="card-head"><div class="sec-title t-purple"><div class="sec-ico"><i class="fas fa-align-left"></i></div><div><h3>About the mentor</h3></div></div></div>
                <div class="card-body"><p class="prose"><%= mentor.bio %></p></div>
            </div>
            <% } %>
        </div>

        <!-- Documents -->
        <div class="md-pane" id="pane-documents">
            <div class="card">
                <div class="card-head">
                    <div class="sec-title t-warn"><div class="sec-ico"><i class="fas fa-file-shield"></i></div>
                        <div><h3>Verification documents</h3><p>Inspect each file carefully. Uploaded does not mean genuine.</p></div></div>
                </div>
                <div class="card-body docs-body">
                    <div class="md-doc-warn"><i class="fas fa-magnifying-glass"></i><span>Look for mismatched fonts, pasted or blurry text, wrong letterhead or signatory, and name, company or date that disagree with the profile. Documents can be edited in minutes, so use the checklist on the right.</span></div>
                    <div class="docs">
                        <% docList.forEach(function (d) { %>
                            <div class="md-doc">
                                <% if (d.url && d.img) { %>
                                    <a class="md-doc-thumb" href="<%= d.url %>" target="_blank" rel="noopener noreferrer" title="Open in new tab">
                                        <img src="<%= d.url %>" alt="<%= d.t %>" loading="lazy" referrerpolicy="no-referrer">
                                        <span class="badge b-info tag"><i class="dot"></i>Uploaded</span>
                                        <span class="hint"><i class="fas fa-up-right-from-square"></i> Open full image</span>
                                    </a>
                                <% } else { %>
                                    <div class="md-doc-thumb">
                                        <i class="fas <%= d.i %>"></i>
                                        <% if (d.url) { %><span class="badge b-info tag"><i class="dot"></i>Uploaded</span>
                                        <% } else { %><span class="badge b-bad tag"><i class="dot"></i>Missing</span><% } %>
                                    </div>
                                <% } %>
                                <div class="md-doc-body">
                                    <div>
                                        <h4><%= d.t %></h4>
                                        <span class="muted small"><%= d.s %><% if (d.url) { %> · <%= d.type %><% } %></span>
                                    </div>
                                    <% if (d.url) { %>
                                        <div class="md-doc-row">
                                            <a href="<%= d.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm"><i class="fas fa-up-right-from-square"></i> Open in new tab</a>
                                        </div>
                                    <% } else { %>
                                        <span class="muted small">Mentor has not uploaded this document.</span>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activity -->
        <div class="md-pane" id="pane-activity">
            <div class="card">
                <div class="card-head"><div><h3>Admin activity</h3><p>Every review and decision on this mentor</p></div></div>
                <div class="card-body">
                    <% if (auditRows.length) { %>
                        <% auditRows.forEach(function (a) {
                            const meta = auditMeta[a.action] || ['fa-circle', ''];
                        %>
                            <div class="au-row">
                                <div class="au-dot <%= meta[1] %>"><i class="fas <%= meta[0] %>"></i></div>
                                <div>
                                    <b><%= a.adminName || a.adminEmail %></b>
                                    <span class="muted"> &middot; <%= auditText[a.action] || a.action %></span>
                                    <div class="muted small"><%= dt(a.createdAt) %> &middot; <%= a.adminEmail %></div>
                                    <% if (a.reason) { %><div class="small text-bad">Reason: <%= a.reason %></div><% } %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="empty"><i class="fas fa-clock-rotate-left"></i><h4>No admin activity yet</h4></div>
                    <% } %>
                </div>
            </div>

            <div class="card">
                <div class="card-head"><div><h3>Account timeline</h3></div></div>
                <div class="card-body timeline">
                    <div class="tl"><i class="fas fa-user-plus"></i><div><b>Registered</b><div class="muted small"><%= dt(mentor.createdAt) %> · <%= ago(mentor.createdAt) %></div></div></div>
                    <div class="tl"><i class="fas fa-pen"></i><div><b>Profile last updated</b><div class="muted small"><%= dt(mentor.updatedAt) %> · <%= ago(mentor.updatedAt) %></div></div></div>
                    <div class="tl"><i class="fas fa-right-to-bracket"></i><div><b>Last login</b><div class="muted small"><%= mentor.lastLoginAt ? dt(mentor.lastLoginAt) : 'Never logged in' %></div></div></div>
                    <div class="tl"><i class="fas fa-shield-halved"></i><div>
                        <b>Current verification: <span class="cap"><%= mentor.status %></span></b>
                        <div class="muted small">Method: <span class="cap"><%= mentor.verificationMethod || 'pending' %></span> · Account: <span class="cap"><%= mentor.accountStatus || 'pending' %></span></div>
                        <% if (mentor.rejectionReason) { %><div class="small text-bad">Reason: <%= mentor.rejectionReason %></div><% } %>
                    </div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ SIDEBAR ============ -->
    <aside class="md-side">

        <!-- Decision panel -->
        <div class="card">
            <div class="card-head"><h3>Verification decision</h3><%- include('partials/status-badge', { st: mentor.status }) %></div>
            <div class="card-body md-decision">

                <% if (mentor.status !== 'approved') { %>
                    <div class="md-ready <%= canApprove ? 'yes' : 'no' %>" id="readyBox">
                        <i class="fas <%= canApprove ? 'fa-circle-check' : 'fa-lock' %>"></i>
                        <span id="readyText"><% if (!docsOk) { %>Required documents are missing. Approval is locked.<% } else if (!review.complete) { %>Approval is locked until you finish and save the manual checklist (<%= reqDone %>/<%= reqChecks.length %> done).<% } else { %>Manual checklist complete. You can approve this mentor.<% } %></span>
                    </div>
                <% } %>

                <% if (mentor.status === 'pending') { %>
                    <button class="btn btn-ok" id="approveBtn" data-action="approve" data-id="<%= mentor._id %>" data-name="<%= mentor.name %>" <%= canApprove ? '' : 'disabled' %>><i class="fas fa-check"></i> Approve mentor</button>
                    <button class="btn btn-bad" data-action="reject" data-id="<%= mentor._id %>" data-name="<%= mentor.name %>"><i class="fas fa-xmark"></i> Reject mentor</button>
                <% } else if (mentor.status === 'approved') { %>
                    <div class="md-ready yes"><i class="fas fa-circle-check"></i> This mentor is approved and active.</div>
                    <button class="btn btn-ghost" data-action="pending" data-id="<%= mentor._id %>" data-name="<%= mentor.name %>"><i class="fas fa-rotate-left"></i> Move back to pending</button>
                    <button class="btn btn-bad" data-action="reject" data-id="<%= mentor._id %>" data-name="<%= mentor.name %>"><i class="fas fa-ban"></i> Revoke &amp; reject</button>
                <% } else { %>
                    <div class="md-ready no"><i class="fas fa-circle-xmark"></i> This mentor was rejected.</div>
                    <% if (mentor.rejectionReason) { %>
                        <div class="reject-box"><div class="small text-bad"><b>Rejection reason</b></div><div class="prose"><%= mentor.rejectionReason %></div></div>
                    <% } %>
                    <button class="btn btn-ok" id="approveBtn" data-action="approve" data-id="<%= mentor._id %>" data-name="<%= mentor.name %>" <%= canApprove ? '' : 'disabled' %>><i class="fas fa-check"></i> Approve now</button>
                    <button class="btn btn-ghost" data-action="pending" data-id="<%= mentor._id %>" data-name="<%= mentor.name %>"><i class="fas fa-rotate-left"></i> Move back to pending</button>
                <% } %>

                <a href="/admin/mentors" class="btn btn-ghost"><i class="fas fa-arrow-left"></i> Back to mentors</a>
            </div>
        </div>

        <!-- Manual verification (the real gate) -->
        <div class="card">
            <div class="card-head">
                <div><h3>Manual verification</h3><p id="rvCount"><%= reqDone %> of <%= reqChecks.length %> required checks done</p></div>
            </div>
            <div class="card-body rv-body">
                <div class="progress flush"><i id="rvBar" data-w="<%= reqPct %>" data-ok="<%= review.complete ? '1' : '0' %>"></i></div>

                <form id="reviewForm" data-url="/admin/mentors/<%= mentor._id %>/review" data-docs-ok="<%= docsOk ? '1' : '0' %>">
                    <% reviewChecks.forEach(function (c) { %>
                        <label class="rv-item <%= review.checks[c.key] ? 'on' : '' %>">
                            <input type="checkbox" name="<%= c.key %>" data-required="<%= c.required ? '1' : '0' %>" <%= review.checks[c.key] ? 'checked' : '' %>>
                            <span>
                                <b><%= c.label %> <% if (c.required) { %><span class="rv-req">*</span><% } else { %><span class="rv-opt">optional</span><% } %></b>
                                <small><%= c.hint %></small>
                            </span>
                        </label>
                    <% }) %>

                    <textarea class="textarea rv-notes" name="notes" rows="3" maxlength="1000" placeholder="Private admin notes (what you checked, who you spoke to...)"><%= review.notes %></textarea>

                    <div class="rv-foot">
                        <span class="rv-meta" id="rvMeta"><% if (review.reviewedAt) { %>Last saved by <b><%= review.reviewedBy && review.reviewedBy.name %></b><br><%= dt(review.reviewedAt) %><% } else { %>Not saved yet<% } %></span>
                        <button type="submit" class="btn btn-primary btn-sm" id="rvSave"><i class="fas fa-floppy-disk"></i> Save review</button>
                    </div>
                </form>
            </div>
        </div>
    </aside>
</div>

<script src="/admin/js/mentor-details.js"></script>

<% } %>

<%- include('partials/layout-end') %>
