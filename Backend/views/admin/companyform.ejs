<%
  const c = locals.c || {};
  const uid = c._id || 'new-' + Math.random().toString(36).slice(2, 8);

  // "Other" must always exist in the dropdown
  const options = categories.includes('Other') ? categories : categories.concat(['Other']);

  // A saved category that is not in the list is a custom one:
  // select "Other" and put the saved text in the custom box.
  const current = c.category || 'Technology';
  const isKnown = options.includes(current);
  const selected = isKnown ? current : 'Other';
  const customValue = isKnown ? '' : current;
  const showOther = selected === 'Other';
%>
<form class="co-form" method="POST" action="/admin/companies" enctype="multipart/form-data" data-loading-form>
  <% if (c._id) { %>
    <input type="hidden" name="id" value="<%= c._id %>">
  <% } %>

  <% if (locals.originalName) { %>
    <input type="hidden" name="originalName" value="<%= locals.originalName %>">
  <% } %>

  <div class="co-field">
    <label class="co-label" for="f-name-<%= uid %>">Company name</label>
    <input
      id="f-name-<%= uid %>"
      type="text"
      name="name"
      value="<%= c.name || '' %>"
      maxlength="80"
      required
      autocomplete="off"
    >
  </div>

  <div class="co-row">
    <div class="co-field">
      <label class="co-label" for="f-ind-<%= uid %>">Industry</label>
      <input id="f-ind-<%= uid %>" type="text" name="industry"
             value="<%= c.industry || 'Technology' %>" placeholder="e.g. IT Services" maxlength="60">
    </div>

    <div class="co-field">
      <label class="co-label" for="f-cat-<%= uid %>">Category</label>
      <select
        id="f-cat-<%= uid %>"
        name="category"
        onchange="var box=this.closest('form').querySelector('[data-other-box]');var inp=box.querySelector('input');box.style.display=this.value==='Other'?'':'none';inp.required=this.value==='Other';if(this.value==='Other')inp.focus();"
      >
        <% options.forEach(function (cat) { %>
          <% if (selected === cat) { %>
            <option value="<%= cat %>" selected><%= cat %></option>
          <% } else { %>
            <option value="<%= cat %>"><%= cat %></option>
          <% } %>
        <% }) %>
      </select>
    </div>
  </div>

  <!-- Shown only when category = Other -->
  <div class="co-field" data-other-box style="display:<%= showOther ? 'grid' : 'none' %>">
    <label class="co-label" for="f-other-<%= uid %>">
      Type category <em>e.g. Aerospace, Gaming, Agriculture</em>
    </label>
    <% if (showOther) { %>
      <input id="f-other-<%= uid %>" type="text" name="customCategory"
             value="<%= customValue %>" maxlength="40"
             placeholder="Enter your category" autocomplete="off" required>
    <% } else { %>
      <input id="f-other-<%= uid %>" type="text" name="customCategory"
             value="" maxlength="40"
             placeholder="Enter your category" autocomplete="off">
    <% } %>
  </div>

  <div class="co-field">
    <span class="co-label">Logo <em>Square &middot; PNG / JPG / WEBP &middot; max 3 MB</em></span>
    <label class="co-drop co-drop--logo">
      <% if (c.logo) { %>
        <img class="co-drop__img" src="<%= c.logo %>" alt="Logo preview">
      <% } else { %>
        <img class="co-drop__img" src="" alt="Logo preview" hidden>
      <% } %>
      <span class="co-drop__text">
        <i class="fas fa-cloud-arrow-up"></i>
        <b><%= c.logo ? 'Replace logo' : 'Upload logo' %></b>
        <small class="co-drop__file">No file chosen</small>
      </span>
      <input class="co-drop__input" type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/avif">
    </label>
  </div>

  <div class="co-field">
    <span class="co-label">Cover image <em>Wide &middot; PNG / JPG / WEBP &middot; max 3 MB</em></span>
    <label class="co-drop co-drop--cover">
      <% if (c.coverImage) { %>
        <img class="co-drop__img" src="<%= c.coverImage %>" alt="Cover preview">
      <% } else { %>
        <img class="co-drop__img" src="" alt="Cover preview" hidden>
      <% } %>
      <span class="co-drop__text">
        <i class="fas fa-cloud-arrow-up"></i>
        <b><%= c.coverImage ? 'Replace cover' : 'Upload cover' %></b>
        <small class="co-drop__file">No file chosen</small>
      </span>
      <input class="co-drop__input" type="file" name="coverImage" accept="image/png,image/jpeg,image/webp,image/avif">
    </label>
  </div>

  <button type="submit" class="co-btn co-btn--block" data-submit-btn>
    <i class="fas fa-check" data-idle-icon></i>
    <span class="co-btn__spinner" aria-hidden="true"></span>
    <span class="co-btn__label" data-label>Save company</span>
  </button>
</form>

<style>
  /* spinner + loading state of the Save button */
  .co-btn__spinner {
    display: none;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, .45);
    border-top-color: #fff;
    border-radius: 50%;
    animation: co-spin .7s linear infinite;
    flex-shrink: 0;
  }
  .co-btn.is-loading { cursor: wait; opacity: .85; pointer-events: none; }
  .co-btn.is-loading .co-btn__spinner { display: inline-block; }
  .co-btn.is-loading [data-idle-icon] { display: none; }
  @keyframes co-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .co-btn__spinner { animation-duration: 1.6s; }
  }
</style>

<script>
  /* Save button loading state (runs once even if this partial is included many times) */
  (function () {
    if (window.__coLoadingInit) return;
    window.__coLoadingInit = true;

    function setLoading(form, on) {
      var btn = form.querySelector('[data-submit-btn]');
      if (!btn) return;
      var label = btn.querySelector('[data-label]');

      if (on) {
        if (label && !btn.dataset.idleText) btn.dataset.idleText = label.textContent;
        btn.classList.add('is-loading');
        btn.disabled = true;
        btn.setAttribute('aria-busy', 'true');
        if (label) label.textContent = 'Saving…';
      } else {
        btn.classList.remove('is-loading');
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
        if (label && btn.dataset.idleText) label.textContent = btn.dataset.idleText;
      }
    }

    // "submit" only fires AFTER the browser validation passed
    document.addEventListener('submit', function (e) {
      var form = e.target;
      if (!form || !form.matches || !form.matches('[data-loading-form]')) return;

      // second click while saving -> ignore
      if (form.dataset.submitting === '1') {
        e.preventDefault();
        return;
      }

      form.dataset.submitting = '1';
      setLoading(form, true);
    });

    // back button / bfcache restores the page -> reset the button
    window.addEventListener('pageshow', function () {
      document.querySelectorAll('[data-loading-form]').forEach(function (form) {
        form.dataset.submitting = '';
        setLoading(form, false);
      });
    });
  })();
</script>
