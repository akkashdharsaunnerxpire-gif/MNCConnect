    </div><!-- /content -->
</div><!-- /main -->

<div class="toast-wrap" id="toasts"></div>

<div class="modal-back" id="modal">
    <div class="modal">
        <h3 id="modalTitle">Are you sure?</h3>
        <p id="modalMsg"></p>
        <div id="modalReasonWrap" style="display:none">
            <label class="label" for="modalReason">Reason (shown to admins only)</label>
            <textarea id="modalReason" class="textarea" placeholder="e.g. Offer letter is not readable"></textarea>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn btn-ghost" id="modalCancel">Cancel</button>
            <button type="button" class="btn btn-ok" id="modalOk">Confirm</button>
        </div>
    </div>
</div>

<script src="/admin/js/admin.js"></script>
</body>
</html>
