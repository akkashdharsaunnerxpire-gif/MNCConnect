<script>
(function () {
  var content = document.querySelector('.content');
  if (!content) return;

  var original = content.innerHTML;   // back button ku restore panna
  var shown = false;

  function row() {
    return '<div class="sk-row">' +
      '<div class="sk sk-av"></div>' +
      '<div class="sk-col"><div class="sk sk-line w40"></div><div class="sk sk-line w60"></div></div>' +
      '<div class="sk sk-line w30" style="flex:none;width:90px"></div>' +
      '<div class="sk sk-btn"></div>' +
    '</div>';
  }

  function stat() {
    return '<div class="card sk-stat"><div class="l">' +
      '<div class="sk sk-line w40" style="margin-bottom:12px"></div>' +
      '<div class="sk" style="height:30px;width:55%"></div></div>' +
      '<div class="sk" style="width:48px;height:48px;border-radius:14px"></div></div>';
  }

  function skeleton() {
    var rows = '';
    for (var i = 0; i < 6; i++) rows += row();
    return '<div class="sk-stats">' + stat() + stat() + stat() + '</div>' +
      '<div class="sk-tabs">' +
        '<div class="sk sk-tab"></div><div class="sk sk-tab"></div>' +
        '<div class="sk sk-tab"></div><div class="sk sk-tab"></div></div>' +
      '<div class="card"><div class="sk-head"><div class="sk sk-line w30"></div></div>' + rows + '</div>';
  }

  function showSkeleton() {
    if (shown) return;
    shown = true;
    content.setAttribute('aria-busy', 'true');
    content.innerHTML = skeleton();
    window.scrollTo({ top: 0 });
  }

  // Internal links click -> skeleton
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href]');
    if (!a) return;
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    if (a.target === '_blank' || a.hasAttribute('download')) return;

    var href = a.getAttribute('href');
    if (!href || href.charAt(0) === '#' || /^(mailto:|tel:|javascript:)/i.test(href)) return;
    if (a.origin !== location.origin) return;
    if (/\/export|\/logout/i.test(a.pathname)) return;           // CSV download / logout ku skeleton vendaam
    if (a.pathname === location.pathname && a.search === location.search) return;

    showSkeleton();
  });

  // GET forms (search / filter) submit -> skeleton
  document.addEventListener('submit', function (e) {
    var f = e.target;
    if (e.defaultPrevented) return;
    if ((f.method || 'get').toLowerCase() === 'get') showSkeleton();
  });

  // Browser Back/Forward la page cache-la irundhu vandha, skeleton stuck aagama irukka
  window.addEventListener('pageshow', function (e) {
    if (e.persisted && shown) {
      content.innerHTML = original;
      content.removeAttribute('aria-busy');
      shown = false;
    }
  });
})();
</script>