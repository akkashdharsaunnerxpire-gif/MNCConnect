<%
  const _page = locals.currentPage || locals.active || "";
  const _admin = locals.admin || { name: "Admin", role: "admin" };

  const _nav = [
    {
      k: "dashboard",
      href: "/admin",
      icon: "fa-chart-pie",
      label: "Dashboard",
    },
    {
      k: "mentors",
      href: "/admin/mentors",
      icon: "fa-user-tie",
      label: "Mentors",
      badge: locals.pendingCount,
    },
    {
      k: "companies",
      href: "/admin/companies",
      icon: "fa-building",
      label: "Companies",
      badge: locals.companyNewCount,
    },
    {
      k: "payments",
      href: "/admin/payments",
      icon: "fa-credit-card",
      label: "Payments",
    },
  ];
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= locals.pageTitle || locals.title || "Admin" %> · MNCConnect Admin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  >

  <link rel="stylesheet" href="/admin/css/admin.css">
</head>

<body>

  <!-- Mobile overlay -->
  <div class="overlay" id="overlay"></div>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">

    <!-- Brand -->
    <div class="brand">
      <div class="brand-logo">
        <i class="fas fa-link"></i>
      </div>

      <div>
        <h1>MNCConnect</h1>
        <p>Admin Panel</p>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="nav">
      <div class="nav-label">Menu</div>

      <% _nav.forEach(function (n) { %>
        <a
          href="<%= n.href %>"
          class="<%= _page === n.k ? 'active' : '' %>"
          <%- _page === n.k ? 'aria-current="page"' : '' %>
        >
          <i class="fas <%= n.icon %>"></i>

          <span><%= n.label %></span>

          <% if (n.k === "companies") { %>
            <%# always rendered so live polling can update it; hidden when 0 %>
            <span class="count" data-co-badge <%- Number(n.badge) > 0 ? "" : "hidden" %>><%= Number(n.badge) || 0 %></span>
          <% } else if (Number(n.badge) > 0) { %>
            <span class="count"><%= n.badge %></span>
          <% } %>
        </a>
      <% }) %>
    </nav>

    <!-- Sidebar footer -->
    <div class="sidebar-foot">
      <a href="/admin/logout">
        <i class="fas fa-right-from-bracket"></i>
        <span>Logout</span>
      </a>
    </div>

  </aside>

  <!-- Main layout -->
  <div class="main">

    <!-- Topbar -->
    <header class="topbar">

      <button
        type="button"
        class="menu-btn"
        id="menuBtn"
        aria-label="Toggle navigation menu"
        aria-controls="sidebar"
        aria-expanded="false"
      >
        <i class="fas fa-bars"></i>
      </button>

      <div>
        <h2><%= locals.title || "Dashboard" %></h2>
        <p><%= locals.pageSubtitle || "" %></p>
      </div>

      <div class="spacer"></div>

      <!-- Admin profile -->
      <div class="admin-chip">
        <div class="av">
          <%= String(_admin.name || "A").charAt(0).toUpperCase() %>
        </div>

        <span>
          <%= _admin.name || "Admin" %>
          <small><%= _admin.role || "admin" %></small>
        </span>
      </div>

    </header>

    <!-- Page content starts here -->
    <div class="content">