<%
  const _page = locals.currentPage || locals.active || "";
  const _admin = locals.admin || { name: "Admin", role: "admin" };

  const _nav = [
    {
      k: "dashboard",
      href: "/admin",
      icon: "fa-chart-pie",
      label: "Dashboard",
    },
    {
      k: "mentors",
      href: "/admin/mentors",
      icon: "fa-user-tie",
      label: "Mentors",
      badge: locals.pendingCount,
    },
    {
      k: "companies",
      href: "/admin/companies",
      icon: "fa-building",
      label: "Companies",
      badge: locals.companyNewCount,
    },
    {
      k: "payments",
      href: "/admin/payments",
      icon: "fa-credit-card",
      label: "Payments",
    },
    {
      k: "withdrawals",
      href: "/admin/withdrawals",
      icon: "fa-wallet",
      label: "Withdrawals",
    },
    {
      k: "finance",
      href: "/admin/finance",
      icon: "fa-sack-dollar",
      label: "Finance",
    },
  ];
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= locals.pageTitle || locals.title || "Admin" %> · MNCConnect Admin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  >

  <link rel="stylesheet" href="/admin/css/admin.css">

  <!-- circular spinner (topbar) -->
  <style>
    .nav-spinner {
      display: none;
      width: 18px;
      height: 18px;
      flex: none;
      border-radius: 50%;
      border: 2px solid #c7d2fe;
      border-top-color: #4f46e5;
      animation: navSpin .7s linear infinite;
      margin-right: 12px;
    }
    html.is-loading .nav-spinner { display: inline-block; }
    @keyframes navSpin { to { transform: rotate(360deg); } }

    @media (prefers-reduced-motion: reduce) {
      .nav-spinner { animation-duration: 1.6s; }
    }
  </style>

  <script>
    (function () {
      var root = document.documentElement;
      var safety = null;

      function on() {
        root.classList.add("is-loading");
        clearTimeout(safety);
        safety = setTimeout(off, 15000);   // never stay stuck
      }
      function off() {
        root.classList.remove("is-loading");
        clearTimeout(safety);
      }

      on();                                                   // first open
      window.addEventListener("load", off);
      window.addEventListener("pageshow", function (e) { if (e.persisted) off(); });

      document.addEventListener("click", function (e) {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        var a = e.target.closest && e.target.closest("a[href]");
        if (!a || (a.target && a.target !== "_self") || a.hasAttribute("download")) return;
        var href = a.getAttribute("href");
        if (!href || href.charAt(0) === "#" || /^(javascript:|mailto:|tel:)/i.test(href)) return;
        var u;
        try { u = new URL(a.href, location.href); } catch (_) { return; }
        if (u.origin !== location.origin) return;
        if (/\/export(\/|$)/.test(u.pathname)) return;
        on();
      });

      document.addEventListener("submit", function (e) {
        var f = e.target;
        setTimeout(function () {
          if (e.defaultPrevented) return;
          if (f && f.target && f.target !== "_self") return;
          on();
        }, 0);
      });

      window.addEventListener("beforeunload", on);            // reload / location.href
    })();
  </script>
</head>

<body>

  <!-- Mobile overlay -->
  <div class="overlay" id="overlay"></div>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">

    <!-- Brand -->
    <div class="brand">
      <div class="brand-logo">
        <i class="fas fa-link"></i>
      </div>

      <div>
        <h1>MNCConnect</h1>
        <p>Admin Panel</p>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="nav">
      <div class="nav-label">Menu</div>

      <% _nav.forEach(function (n) { %>
        <a
          href="<%= n.href %>"
          class="<%= _page === n.k ? 'active' : '' %>"
          <%- _page === n.k ? 'aria-current="page"' : '' %>
        >
          <i class="fas <%= n.icon %>"></i>

          <span><%= n.label %></span>

          <% if (n.k === "companies") { %>
            <%# always rendered so live polling can update it; hidden when 0 %>
            <span class="count" data-co-badge <%- Number(n.badge) > 0 ? "" : "hidden" %>><%= Number(n.badge) || 0 %></span>
          <% } else if (Number(n.badge) > 0) { %>
            <span class="count"><%= n.badge %></span>
          <% } %>
        </a>
      <% }) %>
    </nav>

    <!-- Sidebar footer -->
    <div class="sidebar-foot">
      <a href="/admin/logout">
        <i class="fas fa-right-from-bracket"></i>
        <span>Logout</span>
      </a>
    </div>

  </aside>

  <!-- Main layout -->
  <div class="main">

    <!-- Topbar -->
    <header class="topbar">

      <button
        type="button"
        class="menu-btn"
        id="menuBtn"
        aria-label="Toggle navigation menu"
        aria-controls="sidebar"
        aria-expanded="false"
      >
        <i class="fas fa-bars"></i>
      </button>

      <div>
        <h2><%= locals.pageTitle || locals.title || "Dashboard" %></h2>
        <p><%= locals.pageSubtitle || "" %></p>
      </div>

      <div class="spacer"></div>

      <!-- circular loader (visible only while a page is loading) -->
      <span class="nav-spinner" aria-hidden="true"></span>

      <!-- Admin profile -->
      <div class="admin-chip">
        <div class="av">
          <%= String(_admin.name || "A").charAt(0).toUpperCase() %>
        </div>

        <span>
          <%= _admin.name || "Admin" %>
          <small><%= _admin.role || "admin" %></small>
        </span>
      </div>

    </header>

    <!-- Page content starts here -->
    <div class="content">