<%- include('partials/layout-start', {
  title: locals.title || 'Companies',
  active: locals.active || 'companies'
}) %>

<style>
  /* ---------- small page extras (rest comes from admin.css) ---------- */
  .alert-ok { background: rgba(16,185,129,.08); border-color: rgba(16,185,129,.3); color: #6ee7b7; }
  .alert { overflow-wrap: anywhere; }

  .co-intro { color: var(--muted); max-width: 720px; margin-bottom: 20px; line-height: 1.6; }

  .co-company { display: flex; align-items: center; gap: 14px; min-width: 240px; }
  .co-avatar { width: 46px; height: 46px; flex: none; border-radius: 12px; display: grid; place-items: center; font-weight: 700; font-size: 1rem; color: #c4b5fd; background: rgba(139,92,246,.15); border: 1px solid rgba(139,92,246,.3); overflow: hidden; }
  .co-avatar img { width: 100%; height: 100%; object-fit: contain; padding: 4px; background: #fff; }
  .co-name { font-weight: 600; font-size: 15px; overflow-wrap: anywhere; }

  .co-emp { display: inline-flex; align-items: center; gap: 8px; }
  .co-emp i { color: var(--muted); }

  .co-thumb { border: 1px solid var(--border); border-radius: 10px; background: var(--bg); display: block; }
  .co-thumb--logo { width: 48px; height: 48px; object-fit: contain; padding: 4px; background: #fff; }
  .co-thumb--cover { width: 128px; height: 56px; object-fit: cover; }
  .co-no { display: inline-block; font-size: 12px; color: var(--muted); background: rgba(148,163,184,.08); border: 1px dashed #3b4a63; border-radius: 8px; padding: 8px 12px; }

  /* ---------- modal (centered) ---------- */
  dialog.co-dialog {
    position: fixed; inset: 0; margin: auto;
    width: min(520px, calc(100vw - 24px));
    max-height: calc(100vh - 32px);
    padding: 0; border: 1px solid #2b3a55; border-radius: 18px;
    background: #111827; color: #e2e8f0;
    box-shadow: 0 30px 80px rgba(0,0,0,.6); overflow: hidden;
  }
  dialog.co-dialog[open] { display: flex; flex-direction: column; animation: co-pop .18s ease-out; }
  dialog.co-dialog::backdrop { background: rgba(2,6,23,.72); backdrop-filter: blur(3px); }
  @keyframes co-pop { from { opacity: 0; transform: translateY(8px) scale(.98); } to { opacity: 1; transform: none; } }

  .co-dialog__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 22px; border-bottom: 1px solid #243047; background: #0f1626; }
  .co-dialog__title { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .co-dialog__title h3 { margin: 0; font-size: 1.1rem; color: #f8fafc; overflow-wrap: anywhere; }
  .co-dialog__title small { display: block; color: #8392a8; font-size: .8rem; margin-top: 2px; }
  .co-x { width: 34px; height: 34px; flex: none; display: grid; place-items: center; background: transparent; border: 0; border-radius: 8px; color: #94a3b8; font-size: 1.4rem; cursor: pointer; line-height: 1; }
  .co-x:hover { background: #1e293b; color: #fff; }
  .co-dialog__body { padding: 20px 22px; overflow-y: auto; }
  .co-dialog__foot { padding: 12px 22px 18px; border-top: 1px solid #243047; }
  .co-dialog__foot form { margin: 0; }

  /* ---------- form (used by companyform partial) ---------- */
  .co-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; border: 0; border-radius: 10px; background: linear-gradient(180deg, #8b5cf6, #7c3aed); color: #fff; font-weight: 600; font-size: .9rem; cursor: pointer; transition: .15s; font-family: inherit; }
  .co-btn:hover { filter: brightness(1.1); }
  .co-btn--block { width: 100%; padding: 12px 16px; font-size: .95rem; }
  .co-btn--ghost { background: transparent; border: 1px solid #475569; color: #e2e8f0; }
  .co-btn--ghost:hover { background: #1e293b; filter: none; }
  .co-btn--link-danger { background: transparent; color: #f87171; padding: 6px 0; font-weight: 500; }
  .co-btn--link-danger:hover { color: #fca5a5; filter: none; }

  .co-form { display: grid; gap: 16px; margin: 0; }
  .co-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .co-field { display: grid; gap: 6px; min-width: 0; }
  .co-label { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: .85rem; font-weight: 600; color: #cbd5e1; }
  .co-label em { font-style: normal; font-weight: 400; font-size: .75rem; color: #8392a8; }
  .co-field input[type="text"], .co-field select {
    width: 100%; box-sizing: border-box; padding: 11px 13px; color: #f1f5f9; background: #0b1222;
    border: 1px solid #334155; border-radius: 10px; font-size: .95rem; font-family: inherit; color-scheme: dark;
  }
  .co-field input[type="text"]:focus, .co-field select:focus { outline: none; border-color: #8b5cf6; box-shadow: 0 0 0 3px rgba(139,92,246,.25); }
  .co-field input[readonly] { background: #172033; color: #94a3b8; cursor: not-allowed; }

  .co-drop { position: relative; display: flex; align-items: center; justify-content: center; gap: 14px; padding: 16px; border: 1.5px dashed #3b4a63; border-radius: 12px; background: #0b1222; cursor: pointer; transition: .15s; overflow: hidden; }
  .co-drop:hover, .co-drop.is-over { border-color: #8b5cf6; background: rgba(139,92,246,.06); }
  .co-drop--logo { justify-content: flex-start; min-height: 84px; }
  .co-drop--cover { min-height: 100px; }
  .co-drop__input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
  .co-drop__img { flex: none; border: 1px solid #334155; border-radius: 10px; background: #fff; object-fit: contain; }
  .co-drop--logo .co-drop__img { width: 56px; height: 56px; padding: 4px; }
  .co-drop--cover .co-drop__img { width: 130px; height: 68px; object-fit: cover; padding: 0; }
  .co-drop__img[hidden] { display: none; }
  .co-drop__text { display: grid; gap: 2px; justify-items: start; color: #cbd5e1; font-size: .9rem; min-width: 0; }
  .co-drop__text i { color: #8b5cf6; font-size: 1.15rem; }
  .co-drop__text b { font-weight: 600; }
  .co-drop__file { color: #8392a8; font-size: .78rem; overflow-wrap: anywhere; }

  @media (max-width: 700px) { .co-row { grid-template-columns: 1fr; } }
</style>

<p class="co-intro">
  Every company your employees registered with is added here automatically.
  Upload a logo and a cover image once, and it is shown for all employees of that company.
</p>

<% if (msg) { %>
  <div class="alert alert-ok" role="status"><i class="fas fa-circle-check"></i><div><%= msg %></div></div>
<% } %>
<% if (err) { %>
  <div class="alert alert-bad" role="alert"><i class="fas fa-circle-exclamation"></i><div><%= err %></div></div>
<% } %>

<!-- Stats -->
<div class="grid g-4 mb">
  <div class="card stat t-primary">
    <div><small>Total companies</small><h3><%= stats.total %></h3></div>
    <div class="stat-ico"><i class="fas fa-building"></i></div>
  </div>
  <div class="card stat t-ok">
    <div><small>Logo + cover done</small><h3><%= stats.complete %></h3></div>
    <div class="stat-ico"><i class="fas fa-circle-check"></i></div>
  </div>
  <div class="card stat t-warn">
    <div><small>One image missing</small><h3><%= stats.partial %></h3></div>
    <div class="stat-ico"><i class="fas fa-image"></i></div>
  </div>
  <div class="card stat t-purple">
    <div><small>No images yet</small><h3><%= stats.isNew %></h3></div>
    <div class="stat-ico"><i class="fas fa-plus"></i></div>
  </div>
</div>

<!-- Filter tabs -->
<div class="tabs" id="co-chips">
  <a href="#" class="active" data-filter="all">All <b><%= stats.total %></b></a>
  <a href="#" data-filter="new">No images <b><%= stats.isNew %></b></a>
  <a href="#" data-filter="partial">One missing <b><%= stats.partial %></b></a>
  <a href="#" data-filter="complete">Completed <b><%= stats.complete %></b></a>
</div>

<!-- Search -->
<div class="card mb">
  <div class="card-body" style="padding:16px 20px;">
    <div class="filters">
      <div class="search-box">
        <i class="fas fa-search"></i>
        <input id="co-search" class="input" type="text" placeholder="Search company name...">
      </div>
    </div>
  </div>
</div>

<!-- Table -->
<div class="card">
  <% if (rows.length === 0) { %>
    <div class="empty">
      <i class="fas fa-building"></i>
      <h4>No companies yet</h4>
      <p>No employee has registered with a company name.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Company</th>
            <th>Employees</th>
            <th>Logo</th>
            <th>Cover</th>
            <th>Status</th>
            <th class="t-right">Actions</th>
          </tr>
        </thead>
        <tbody id="co-body">
          <% rows.forEach(function (r, i) { %>
            <tr data-status="<%= r.status %>" data-name="<%= r.name.toLowerCase() %>">
              <td>
                <div class="co-company">
                  <div class="co-avatar">
                    <% if (r.hasLogo) { %>
                      <img src="<%= r.doc.logo %>" alt="" loading="lazy">
                    <% } else { %>
                      <%= String(r.name).trim().charAt(0).toUpperCase() %>
                    <% } %>
                  </div>
                  <div>
                    <div class="co-name"><%= r.name %></div>
                    <div class="muted small"><%= r.doc ? (r.doc.industry || 'Technology') + ' · ' + (r.doc.category || 'Technology') : 'No profile yet' %></div>
                  </div>
                </div>
              </td>

              <td><span class="co-emp"><i class="fas fa-user-group"></i> <%= r.employees %></span></td>

              <td>
                <% if (r.hasLogo) { %>
                  <img class="co-thumb co-thumb--logo" src="<%= r.doc.logo %>" alt="<%= r.name %> logo" loading="lazy">
                <% } else { %>
                  <span class="co-no">No logo</span>
                <% } %>
              </td>

              <td>
                <% if (r.hasCover) { %>
                  <img class="co-thumb co-thumb--cover" src="<%= r.doc.coverImage %>" alt="<%= r.name %> cover" loading="lazy">
                <% } else { %>
                  <span class="co-no">No cover</span>
                <% } %>
              </td>

              <td>
                <% if (r.status === 'complete') { %>
                  <span class="badge b-ok"><i class="dot"></i>Updated</span>
                <% } else if (r.status === 'partial') { %>
                  <span class="badge b-warn"><i class="dot"></i>One image missing</span>
                <% } else { %>
                  <span class="badge b-purple"><i class="dot"></i>No images</span>
                <% } %>
              </td>

              <td>
                <div class="row-actions">
                  <button type="button"
                          class="btn btn-sm <%= r.status === 'complete' ? 'btn-ghost' : 'btn-primary' %>"
                          data-open="dlg-<%= i %>">
                    <i class="fas <%= r.status === 'complete' ? 'fa-pen' : 'fa-upload' %>"></i>
                    <%= r.status === 'complete' ? 'Edit' : 'Upload' %>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div id="co-none" class="empty" style="display:none">
      <i class="fas fa-magnifying-glass"></i>
      <h4>No company matches your search</h4>
    </div>
  <% } %>
</div>

<!-- One modal per registered company -->
<% rows.forEach(function (r, i) { %>
  <dialog class="co-dialog" id="dlg-<%= i %>">
    <div class="co-dialog__head">
      <div class="co-dialog__title">
        <div class="co-avatar">
          <% if (r.hasLogo) { %>
            <img src="<%= r.doc.logo %>" alt="">
          <% } else { %>
            <%= String(r.name).trim().charAt(0).toUpperCase() %>
          <% } %>
        </div>
        <div>
          <h3><%= r.name %></h3>
          <small><%= r.employees %> employee<%= r.employees === 1 ? '' : 's' %> registered</small>
        </div>
      </div>
      <button type="button" class="co-x" aria-label="Close" data-close>&times;</button>
    </div>

    <div class="co-dialog__body">
      <%- include('companyform', {
        c: r.doc || { name: r.name },
        originalName: r.name,
        lockName: false,
        categories: categories
      }) %>
    </div>

    <% if (r.doc) { %>
      <div class="co-dialog__foot">
        <form method="POST" action="/admin/companies/<%= r.doc._id %>/delete"
              onsubmit="return confirm('Delete this company? Its images will also be removed.');">
          <button type="submit" class="co-btn co-btn--link-danger">
            <i class="fas fa-trash"></i> Delete company
          </button>
        </form>
      </div>
    <% } %>
  </dialog>
<% }) %>

<script>
  (function () {
    /* ---------- search + filter ---------- */
    var search = document.getElementById('co-search');
    var chips = document.querySelectorAll('#co-chips a');
    var rows = document.querySelectorAll('#co-body tr');
    var none = document.getElementById('co-none');
    var filter = 'all';

    function apply() {
      var q = ((search && search.value) || '').toLowerCase().trim();
      var shown = 0;
      rows.forEach(function (tr) {
        var okStatus = filter === 'all' || tr.dataset.status === filter;
        var okName = !q || tr.dataset.name.indexOf(q) !== -1;
        var show = okStatus && okName;
        tr.style.display = show ? '' : 'none';
        if (show) shown++;
      });
      if (none) none.style.display = shown ? 'none' : 'block';
    }

    if (search) search.addEventListener('input', apply);

    chips.forEach(function (chip) {
      chip.addEventListener('click', function (e) {
        e.preventDefault();
        chips.forEach(function (c) { c.classList.remove('active'); });
        chip.classList.add('active');
        filter = chip.dataset.filter;
        apply();
      });
    });

    /* ---------- open / close modals ---------- */
    document.querySelectorAll('[data-open]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var d = document.getElementById(btn.dataset.open);
        if (d && d.showModal) d.showModal();
      });
    });

    document.querySelectorAll('dialog.co-dialog').forEach(function (d) {
      d.addEventListener('click', function (e) {
        if (e.target === d) d.close();
      });
      var x = d.querySelector('[data-close]');
      if (x) x.addEventListener('click', function () { d.close(); });
    });

    /* ---------- live image preview + size check ---------- */
    var MAX = 3 * 1024 * 1024;

    document.querySelectorAll('.co-drop__input').forEach(function (input) {
      input.addEventListener('change', function () {
        var box = input.closest('.co-drop');
        var img = box.querySelector('.co-drop__img');
        var label = box.querySelector('.co-drop__file');
        var file = input.files && input.files[0];

        if (!file) { label.textContent = 'No file chosen'; return; }

        if (file.size > MAX) {
          alert('Image is larger than 3 MB. Please choose a smaller file.');
          input.value = '';
          label.textContent = 'No file chosen';
          return;
        }

        label.textContent = file.name;
        img.src = URL.createObjectURL(file);
        img.hidden = false;
      });

      var zone = input.closest('.co-drop');
      ['dragenter', 'dragover'].forEach(function (ev) {
        zone.addEventListener(ev, function () { zone.classList.add('is-over'); });
      });
      ['dragleave', 'drop'].forEach(function (ev) {
        zone.addEventListener(ev, function () { zone.classList.remove('is-over'); });
      });
    });
  })();
</script>

<%- include('partials/layout-end') %>