<%- include('partials/layout-start') %>

<%
  const isFreshers = mode === 'freshers';
  const basePath = isFreshers ? '/admin/freshers' : '/admin/users';
  const roleBadge = (r) => r === 'admin' ? 'b-purple' : r === 'mentor' ? 'b-info' : 'b-ok';
%>

<% if (modelMissing) { %>
    <div class="alert alert-warn">
        <i class="fas fa-triangle-exclamation"></i>
        <div>User model was not found. Make sure <code>models/User.js</code> exists and exports a Mongoose model named <b>User</b>.</div>
    </div>
<% } %>

<div class="card mb">
    <div class="card-body" style="padding:16px 20px;">
        <form method="GET" action="<%= basePath %>" class="filters">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input class="input" type="text" name="search" value="<%= search %>" placeholder="Search by name or email...  (press / )">
            </div>
            <% if (!isFreshers) { %>
            <select name="role" class="select" data-autosubmit>
                <option value="all" <%= role === 'all' ? 'selected' : '' %>>All roles</option>
                <option value="admin" <%= role === 'admin' ? 'selected' : '' %>>Admin</option>
                <option value="mentor" <%= role === 'mentor' ? 'selected' : '' %>>Mentor</option>
                <option value="fresher" <%= role === 'fresher' ? 'selected' : '' %>>Fresher</option>
                <option value="user" <%= role === 'user' ? 'selected' : '' %>>User</option>
            </select>
            <% } %>
            <select name="status" class="select" data-autosubmit>
                <option value="all" <%= status === 'all' ? 'selected' : '' %>>All status</option>
                <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
            <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i> Search</button>
            <a href="<%= basePath %>" class="btn btn-ghost"><i class="fas fa-rotate-left"></i> Reset</a>
            <span class="badge b-info" style="margin-left:auto;"><i class="fas fa-users"></i>&nbsp;Total: <%= pagination.total %></span>
        </form>
    </div>
</div>

<div class="card">
    <% if (users.length) { %>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>User</th><th>Role</th><th>Status</th><th>Joined</th><th class="t-right">Actions</th></tr>
            </thead>
            <tbody>
            <% users.forEach(function (u) { %>
                <tr>
                    <td>
                        <div class="cell-user">
                            <div class="av"><%= (u.name || u.email || 'U').charAt(0).toUpperCase() %></div>
                            <div><b><%= u.name || 'Unnamed' %></b><span class="muted small"><%= u.email || '—' %></span></div>
                        </div>
                    </td>
                    <td><span class="badge <%= roleBadge(u.role) %>"><%= u.role || 'user' %></span></td>
                    <td>
                        <% if (u.isActive === false) { %>
                            <span class="badge b-bad"><i class="dot"></i>Inactive</span>
                        <% } else { %>
                            <span class="badge b-ok"><i class="dot"></i>Active</span>
                        <% } %>
                    </td>
                    <td class="muted small"><%= u.createdAt ? new Date(u.createdAt).toLocaleDateString('en-GB') : '—' %></td>
                    <td>
                        <div class="row-actions">
                            <% if (u.role !== 'admin') { %>
                                <% if (u.isActive === false) { %>
                                    <button class="btn btn-ok btn-sm" data-action="toggle-user" data-next="activate" data-id="<%= u._id %>" data-name="<%= u.name || u.email %>"><i class="fas fa-user-check"></i> Activate</button>
                                <% } else { %>
                                    <button class="btn btn-ghost btn-sm" data-action="toggle-user" data-next="deactivate" data-id="<%= u._id %>" data-name="<%= u.name || u.email %>"><i class="fas fa-user-slash"></i> Deactivate</button>
                                <% } %>
                            <% } else { %>
                                <span class="muted small">Protected</span>
                            <% } %>
                        </div>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
    <%- include('partials/pagination') %>
    <% } else { %>
        <div class="empty"><i class="fas fa-user"></i><h4>No users found</h4><p>Try adjusting your search or filter.</p></div>
    <% } %>
</div>

<%- include('partials/layout-end') %>
