<%- include('partials/layout-start') %>

<%
  const fmt = (n) => Number(n || 0).toLocaleString('en-IN');
  const stBadge = (s) => {
    s = String(s || '').toLowerCase();
    if (['success', 'paid', 'captured', 'completed', 'successful'].includes(s)) return 'b-ok';
    if (['failed', 'cancelled', 'canceled', 'error'].includes(s)) return 'b-bad';
    if (['refunded'].includes(s)) return 'b-purple';
    return 'b-warn';
  };
  const tabs = [
    { k: 'all', l: 'All' },
    { k: 'success', l: 'Successful' },
    { k: 'pending', l: 'Pending' },
    { k: 'failed', l: 'Failed' }
  ];
%>

<% if (modelMissing) { %>
    <div class="alert alert-warn">
        <i class="fas fa-triangle-exclamation"></i>
        <div>Payment model was not found. Make sure <code>models/Payment.js</code> exists and exports a Mongoose model named <b>Payment</b>.</div>
    </div>
<% } %>

<div class="grid g-3 mb">
    <div class="card stat t-primary"><div><small>Total Payments</small><h3><%= fmt(summary.count) %></h3></div><div class="stat-ico"><i class="fas fa-receipt"></i></div></div>
    <div class="card stat t-ok"><div><small>Revenue (successful)</small><h3>₹<%= fmt(summary.revenue) %></h3></div><div class="stat-ico"><i class="fas fa-indian-rupee-sign"></i></div></div>
    <div class="card stat t-bad"><div><small>Failed</small><h3><%= fmt(summary.failed) %></h3></div><div class="stat-ico"><i class="fas fa-circle-xmark"></i></div></div>
</div>

<div class="tabs">
    <% tabs.forEach(function (t) { %>
        <a href="/admin/payments?status=<%= t.k %>" class="<%= status === t.k ? 'active' : '' %>"><%= t.l %></a>
    <% }) %>
</div>

<div class="card">
    <% if (payments.length) { %>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Payment ID</th><th>Payer</th><th>Amount</th><th>Status</th><th>Date</th></tr>
            </thead>
            <tbody>
            <% payments.forEach(function (p) {
                const pid = p.paymentId || p.razorpayPaymentId || p.razorpay_payment_id || p.transactionId || p.orderId || String(p._id);
                const payer = p.email || p.userEmail || p.name || (p.user ? String(p.user) : '') || (p.fresher ? String(p.fresher) : '');
            %>
                <tr>
                    <td class="mono"><%= pid %></td>
                    <td class="muted"><%= payer || '—' %></td>
                    <td><b><%= (p.currency && p.currency !== 'INR' ? p.currency + ' ' : '₹') %><%= fmt(p.amount) %></b></td>
                    <td><span class="badge <%= stBadge(p.status) %>"><i class="dot"></i><%= p.status || 'unknown' %></span></td>
                    <td class="muted small"><%= p.createdAt ? new Date(p.createdAt).toLocaleString('en-GB') : '—' %></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
    <%- include('partials/pagination') %>
    <% } else { %>
        <div class="empty"><i class="fas fa-credit-card"></i><h4>No payments found</h4><p>Payments will appear here once users start paying.</p></div>
    <% } %>
</div>

<p class="muted small" style="margin-top:14px;">
    Amounts are shown exactly as stored in the database. If you store amounts in paise, divide by 100 in the controller.
</p>

<%- include('partials/layout-end') %>
