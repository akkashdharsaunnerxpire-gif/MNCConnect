<% 
  pageTitle = 'Payments';
  pageSubtitle = 'Manage all payments';
  currentPage = 'payments';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MNCConnect Admin - Payments</title>
    <link rel="stylesheet" href="/admin/css/output.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-slate-950 text-white min-h-screen">
    
    <div class="flex h-screen">
        <aside class="w-64 bg-slate-900 border-r border-slate-800 fixed h-full overflow-y-auto">
            <div class="p-6 border-b border-slate-800">
                <h1 class="text-2xl font-bold text-indigo-500">MNCConnect</h1>
                <p class="text-sm text-slate-400">Admin Panel</p>
            </div>
            <nav class="p-4 space-y-2">
                <a href="/admin" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition">
                    <i class="fas fa-chart-pie w-5"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/admin/mentors" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition">
                    <i class="fas fa-users w-5"></i>
                    <span>Mentors</span>
                </a>
                <a href="/admin/freshers" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition">
                    <i class="fas fa-graduation-cap w-5"></i>
                    <span>Freshers</span>
                </a>
                <a href="/admin/payments" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-indigo-600 transition">
                    <i class="fas fa-credit-card w-5"></i>
                    <span>Payments</span>
                </a>
                <a href="/admin/users" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition">
                    <i class="fas fa-user-cog w-5"></i>
                    <span>Users</span>
                </a>
                <a href="/admin/logout" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-red-600/20 text-red-400 transition mt-8">
                    <i class="fas fa-sign-out-alt w-5"></i>
                    <span>Logout</span>
                </a>
            </nav>
        </aside>
        
        <main class="ml-64 flex-1 p-8 overflow-y-auto">
            <div class="flex justify-between items-center mb-8">
                <div>
                    <h2 class="text-3xl font-bold text-white">Payments</h2>
                    <p class="text-slate-400">Manage all payments</p>
                </div>
                <span class="text-slate-400"><i class="fas fa-user-circle text-2xl"></i> <%= admin ? admin.name : 'Admin' %></span>
            </div>
            
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
                <div class="flex items-center justify-between mb-6">
                    <p class="text-slate-400">Track and manage all transactions</p>
                    <span class="bg-emerald-600/20 text-emerald-400 px-4 py-2 rounded-lg text-sm">
                        <i class="fas fa-credit-card"></i> Total: <%= payments ? payments.length : 0 %>
                    </span>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-slate-800">
                                <th class="text-left px-4 py-3 text-sm text-slate-400">User</th>
                                <th class="text-left px-4 py-3 text-sm text-slate-400">Amount</th>
                                <th class="text-left px-4 py-3 text-sm text-slate-400">Status</th>
                                <th class="text-left px-4 py-3 text-sm text-slate-400">Method</th>
                                <th class="text-left px-4 py-3 text-sm text-slate-400">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (payments && payments.length > 0) { %>
                                <% payments.forEach(function(payment) { %>
                                    <tr class="border-b border-slate-800 hover:bg-slate-800/50 transition">
                                        <td class="px-4 py-3 text-white"><%= payment.userName || 'N/A' %></td>
                                        <td class="px-4 py-3 text-emerald-400 font-medium">₹<%= payment.amount %></td>
                                        <td class="px-4 py-3">
                                            <span class="px-3 py-1 rounded-full text-xs font-medium 
                                                <%= payment.status === 'completed' ? 'bg-emerald-600/20 text-emerald-400' : 
                                                   payment.status === 'pending' ? 'bg-yellow-600/20 text-yellow-400' : 
                                                   'bg-red-600/20 text-red-400' %>">
                                                <%= payment.status || 'pending' %>
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-slate-300"><%= payment.method || 'N/A' %></td>
                                        <td class="px-4 py-3 text-slate-400 text-sm">
                                            <%= new Date(payment.createdAt).toLocaleDateString() %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="px-4 py-12 text-center text-slate-400">
                                        <i class="fas fa-money-bill-wave text-4xl block mb-3 text-slate-600"></i>
                                        <p>No payments recorded yet</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
    
    <script src="/admin/js/admin.js"></script>
</body>
</html>