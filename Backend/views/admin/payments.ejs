<%- include('partials/layout-start') %>

<%
  const fmt = (n) => Number(n || 0).toLocaleString('en-IN', { maximumFractionDigits: 2 });
  const stBadge = (s) => {
    s = String(s || '').toLowerCase();
    if (['success', 'paid', 'captured', 'completed', 'successful'].includes(s)) return 'b-ok';
    if (['failed', 'cancelled', 'canceled', 'error'].includes(s)) return 'b-bad';
    if (s === 'refunded') return 'b-purple';
    return 'b-warn';
  };
  const tabs = [
    { k: 'all', l: 'All' },
    { k: 'success', l: 'Successful' },
    { k: 'pending', l: 'Pending' },
    { k: 'failed', l: 'Failed' },
    { k: 'refunded', l: 'Refunded' }
  ];
%>

<% if (modelMissing) { %>
    <div class="alert alert-warn">
        <i class="fas fa-triangle-exclamation"></i>
        <div>Payment model was not found. Make sure <code>models/Payment.js</code> exists.</div>
    </div>
<% } else { %>

<div class="grid g-3 mb">
    <div class="card stat t-primary"><div><small>Total Payments</small><h3><%= fmt(finance.count) %></h3></div><div class="stat-ico"><i class="fas fa-receipt"></i></div></div>
    <div class="card stat t-ok"><div><small>Session revenue (paid, not refunded)</small><h3>₹<%= fmt(finance.sessionRevenue) %></h3>
        <small class="muted">Convenience fees kept ₹<%= fmt(finance.convenienceRetained) %></small></div><div class="stat-ico"><i class="fas fa-indian-rupee-sign"></i></div></div>
    <div class="card stat t-bad"><div><small>Refunded (to customers)</small><h3>₹<%= fmt(finance.refundedTotal) %></h3>
        <small class="muted">Session ₹<%= fmt(finance.refunded) %> · convenience ₹<%= fmt(finance.refundedConvenience) %></small></div><div class="stat-ico"><i class="fas fa-rotate-left"></i></div></div>
</div>

<div class="grid g-3 mb">
    <div class="card stat t-ok"><div><small>Platform profit (net, earned)</small><h3>₹<%= fmt(finance.netProfit) %></h3>
        <small class="muted">Fee ₹<%= fmt(finance.grossProfit) %> + conv. ₹<%= fmt(finance.convenienceRecognized) %> − gateway ₹<%= fmt(finance.gatewayCost) %></small></div><div class="stat-ico"><i class="fas fa-chart-line"></i></div></div>
    <div class="card stat <%= finance.unrecoveredGatewayCharges > 0 ? 't-bad' : 't-ok' %>"><div><small>Unrecovered gateway charges</small><h3>₹<%= fmt(finance.unrecoveredGatewayCharges) %></h3></div><div class="stat-ico"><i class="fas fa-triangle-exclamation"></i></div></div>
    <div class="card stat t-primary"><div><small>Mentors owed now</small><h3>₹<%= fmt(finance.mentorOwed) %></h3>
        <small class="muted">Earned ₹<%= fmt(finance.mentorEarned) %> · Paid ₹<%= fmt(finance.mentorPaid) %></small></div><div class="stat-ico"><i class="fas fa-users"></i></div></div>
</div>

<% if (finance.estimatedRows > 0) { %>
    <div class="alert alert-warn" style="margin-bottom:14px;">
        <i class="fas fa-circle-info"></i>
        <div><%= finance.estimatedRows %> payment(s) use an estimated gateway fee. <a href="/admin/finance">Open Finance</a> and click "Sync fees" for exact numbers.</div>
    </div>
<% } %>

<% } %>

<div class="tabs">
    <% tabs.forEach(function (t) { %>
        <a href="/admin/payments?status=<%= t.k %>" class="<%= status === t.k ? 'active' : '' %>"><%= t.l %></a>
    <% }) %>
</div>

<div class="card">
    <% if (payments.length) { %>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Payment ID</th><th>Fresher</th><th>Session price</th><th>Conv. fee</th><th>Customer paid</th><th>Platform fee</th><th>Mentor share</th><th>Razorpay cost</th><th>Refund</th><th>Status</th><th>Date</th></tr>
            </thead>
            <tbody>
            <% payments.forEach(function (p) {
                const pid = p.razorpayPaymentId || p.razorpayOrderId || String(p._id);
                const payer = p.fresherName || p.fresherEmail || (p.fresher ? String(p.fresher) : '');
            %>
                <tr>
                    <td class="mono"><%= pid %></td>
                    <td class="muted"><%= payer || '—' %><% if (p.method === 'wallet') { %> <span class="small">(wallet)</span><% } %></td>
                    <td><b>₹<%= fmt(p.amount) %></b></td>
                    <td class="muted">₹<%= fmt(p.convenienceFee) %></td>
                    <td class="muted">₹<%= fmt(p.checkoutAmount > 0 ? p.checkoutAmount : p.amount) %></td>
                    <td class="muted">₹<%= fmt(p.platformFee) %></td>
                    <td class="muted">₹<%= fmt(p.mentorEarning) %></td>
                    <td class="muted">₹<%= fmt(p.gatewayFee) %><%= p.feeEstimated ? ' (est.)' : '' %></td>
                    <td class="muted"><%= p.status === 'refunded' ? '₹' + fmt(p.refundAmount > 0 ? p.refundAmount : p.amount) + ' → ' + (p.refundMethod || '—') : '—' %></td>
                    <td><span class="badge <%= stBadge(p.status) %>"><i class="dot"></i><%= p.status || 'unknown' %></span></td>
                    <td class="muted small"><%= p.createdAt ? new Date(p.createdAt).toLocaleString('en-GB') : '—' %></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
    <%- include('partials/pagination') %>
    <% } else { %>
        <div class="empty"><i class="fas fa-credit-card"></i><h4>No payments found</h4><p>Payments will appear here once users start paying.</p></div>
    <% } %>
</div>

<p class="muted small" style="margin-top:14px;">
    Profit is counted only after a session is completed. Held money may still be refunded, so it is not counted as profit.
    Mentor share and platform fee are always calculated from the session price, never from the convenience fee.
</p>

<%- include('partials/layout-end') %>
