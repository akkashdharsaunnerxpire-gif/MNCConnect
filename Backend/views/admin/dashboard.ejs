<%- include('partials/layout-start') %>

<%
  const fmt = (n) => Number(n || 0).toLocaleString('en-IN');
  const total = stats.totalMentors;
  const aDeg = total ? (stats.approvedMentors / total) * 360 : 0;
  const pDeg = total ? (stats.pendingMentors / total) * 360 : 0;
  const donutBg = total
    ? 'conic-gradient(#10b981 0deg ' + aDeg + 'deg, #f59e0b ' + aDeg + 'deg ' + (aDeg + pDeg) + 'deg, #ef4444 ' + (aDeg + pDeg) + 'deg 360deg)'
    : '';
  const maxMonth = Math.max.apply(null, monthly.map(function (m) { return m.count; }).concat([1]));
  const maxCompany = Math.max.apply(null, topCompanies.map(function (c) { return c.count; }).concat([1]));

  const mentorCards = [
    { l: 'Total mentors', v: stats.totalMentors, i: 'fa-user-tie', t: 't-primary', href: '/admin/mentors' },
    { l: 'Pending approvals', v: stats.pendingMentors, i: 'fa-clock', t: 't-warn', href: '/admin/mentors?status=pending' },
    { l: 'Approved mentors', v: stats.approvedMentors, i: 'fa-circle-check', t: 't-ok', href: '/admin/mentors?status=approved' },
    { l: 'Rejected mentors', v: stats.rejectedMentors, i: 'fa-circle-xmark', t: 't-bad', href: '/admin/mentors?status=rejected' }
  ];

  const platformCards = [];
  if (stats.totalUsers !== null && stats.totalUsers !== undefined) platformCards.push({ l: 'Total users', v: fmt(stats.totalUsers), i: 'fa-users', t: 't-info', href: '/admin/users' });
  if (stats.totalPayments !== null && stats.totalPayments !== undefined) platformCards.push({ l: 'Payments', v: fmt(stats.totalPayments), i: 'fa-receipt', t: 't-primary', href: '/admin/payments' });
  if (stats.revenue !== null && stats.revenue !== undefined) platformCards.push({ l: 'Revenue', v: '₹' + fmt(stats.revenue), i: 'fa-indian-rupee-sign', t: 't-ok', href: '/admin/payments' });
%>

<% if (stats.pendingMentors > 0) { %>
<div class="alert alert-warn">
    <i class="fas fa-bell"></i>
    <div><b><%= stats.pendingMentors %></b> mentor<%= stats.pendingMentors > 1 ? 's are' : ' is' %> waiting for verification.</div>
    <a href="/admin/mentors?status=pending" class="btn btn-sm btn-primary">Review now</a>
</div>
<% } %>

<!-- Mentor stats -->
<div class="grid g-4 mb">
    <% mentorCards.forEach(function (c) { %>
        <a href="<%= c.href %>" class="card stat <%= c.t %>">
            <div><small><%= c.l %></small><h3><%= c.v %></h3></div>
            <div class="stat-ico"><i class="fas <%= c.i %>"></i></div>
        </a>
    <% }) %>
</div>

<!-- Platform stats (only if the models exist) -->
<% if (platformCards.length) { %>
<div class="grid g-3 mb">
    <% platformCards.forEach(function (c) { %>
        <a href="<%= c.href %>" class="card stat <%= c.t %>">
            <div><small><%= c.l %></small><h3><%= c.v %></h3></div>
            <div class="stat-ico"><i class="fas <%= c.i %>"></i></div>
        </a>
    <% }) %>
</div>
<% } %>

<!-- Charts -->
<div class="grid g-main mb">
    <div class="card">
        <div class="card-head">
            <div><h3>Mentor registrations</h3><p>Last 6 months</p></div>
        </div>
        <div class="card-body">
            <div class="bars">
                <% monthly.forEach(function (m) { %>
                    <div class="bar" title="<%= m.count %> registrations">
                        <b><%= m.count %></b>
                        <div class="bar-fill" data-h="<%= Math.round((m.count / maxMonth) * 100) %>"></div>
                        <span><%= m.label %></span>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <div><h3>Verification status</h3><p>Approval rate: <b><%= approvalRate %>%</b></p></div>
        </div>
        <div class="card-body donut-wrap">
            <div class="donut" data-bg="<%= donutBg %>">
                <div class="donut-in"><div><b><%= total %></b><small>Mentors</small></div></div>
            </div>
            <div class="legend">
                <div><i class="lg-ok"></i>Approved<span><%= stats.approvedMentors %></span></div>
                <div><i class="lg-warn"></i>Pending<span><%= stats.pendingMentors %></span></div>
                <div><i class="lg-bad"></i>Rejected<span><%= stats.rejectedMentors %></span></div>
            </div>
        </div>
    </div>
</div>

<!-- Pending queue + Top companies -->
<div class="grid g-main mb">
    <div class="card">
        <div class="card-head">
            <div><h3>Pending verification queue</h3><p>Oldest requests first</p></div>
            <a href="/admin/mentors?status=pending" class="btn btn-ghost btn-sm">View all</a>
        </div>
        <% if (pendingQueue.length) { %>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Mentor</th><th>Company</th><th>Applied</th><th class="t-right">Actions</th></tr></thead>
                <tbody>
                <% pendingQueue.forEach(function (m) { %>
                    <tr>
                        <td>
                            <div class="cell-user">
                                <div class="av"><%= (m.name || 'M').charAt(0).toUpperCase() %></div>
                                <div><b><%= m.name || 'Unnamed' %></b><span class="muted small"><%= m.email || '' %></span></div>
                            </div>
                        </td>
                        <td class="muted"><%= m.currentCompany || '—' %></td>
                        <td class="muted small"><%= m.createdAt ? new Date(m.createdAt).toLocaleDateString('en-GB') : '—' %></td>
                        <td>
                            <div class="row-actions">
                                <a href="/admin/mentors/<%= m._id %>" class="btn btn-primary btn-sm"><i class="fas fa-magnifying-glass"></i> Review</a>
                            </div>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
        <% } else { %>
            <div class="empty"><i class="fas fa-check-double"></i><h4>All caught up</h4><p>No mentors waiting for review.</p></div>
        <% } %>
    </div>

    <div class="card">
        <div class="card-head"><div><h3>Top companies</h3><p>By mentor count</p></div></div>
        <div class="card-body">
            <% if (topCompanies.length) { %>
                <% topCompanies.forEach(function (c) { %>
                    <div class="list-row block">
                        <div class="lr-top"><span><%= c.name %></span><b><%= c.count %></b></div>
                        <div class="progress"><i data-w="<%= Math.round((c.count / maxCompany) * 100) %>"></i></div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty">No company data yet</div>
            <% } %>
        </div>
    </div>
</div>

<!-- Recent mentors -->
<div class="card">
    <div class="card-head">
        <div><h3>Recently registered</h3><p>Latest 5 mentors</p></div>
        <a href="/admin/mentors" class="btn btn-ghost btn-sm">All mentors</a>
    </div>
    <% if (recentMentors.length) { %>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Mentor</th><th>Designation</th><th>Status</th><th>Joined</th><th class="t-right"></th></tr></thead>
            <tbody>
            <% recentMentors.forEach(function (m) { %>
                <tr>
                    <td>
                        <div class="cell-user">
                            <div class="av"><% if (m.profilePic) { %><img src="<%= m.profilePic %>" alt=""><% } else { %><%= (m.name || 'M').charAt(0).toUpperCase() %><% } %></div>
                            <div><b><%= m.name || 'Unnamed' %></b><span class="muted small"><%= m.email || '' %></span></div>
                        </div>
                    </td>
                    <td class="muted"><%= m.designation || '—' %><% if (m.currentCompany) { %> · <%= m.currentCompany %><% } %></td>
                    <td><%- include('partials/status-badge', { st: m.status }) %></td>
                    <td class="muted small"><%= m.createdAt ? new Date(m.createdAt).toLocaleDateString('en-GB') : '—' %></td>
                    <td class="t-right"><a href="/admin/mentors/<%= m._id %>" class="btn btn-ghost btn-sm">View</a></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
    <% } else { %>
        <div class="empty"><i class="fas fa-users"></i><h4>No mentors yet</h4></div>
    <% } %>
</div>

<%- include('partials/layout-end') %>
