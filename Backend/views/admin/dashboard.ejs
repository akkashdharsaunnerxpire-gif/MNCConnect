<% 
  pageTitle = 'Dashboard';
  pageSubtitle = 'Overview of your platform';
  currentPage = 'dashboard';
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MNCConnect Admin - Dashboard</title>
    <link rel="stylesheet" href="/admin/css/output.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-slate-950 text-white min-h-screen">
    
    <!-- Sidebar -->
    <div class="flex h-screen">
        <aside class="w-64 bg-slate-900 border-r border-slate-800 fixed h-full overflow-y-auto">
            <div class="p-6 border-b border-slate-800">
                <h1 class="text-2xl font-bold text-indigo-500">MNCConnect</h1>
                <p class="text-sm text-slate-400">Admin Panel</p>
            </div>
            
            <nav class="p-4 space-y-2">
                <a href="/admin" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-indigo-600 transition">
                    <i class="fas fa-chart-pie w-5"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/admin/mentors" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition">
                    <i class="fas fa-users w-5"></i>
                    <span>Mentors</span>
                </a>
                <a href="/admin/freshers" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition">
                    <i class="fas fa-graduation-cap w-5"></i>
                    <span>Freshers</span>
                </a>
                <a href="/admin/payments" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition">
                    <i class="fas fa-credit-card w-5"></i>
                    <span>Payments</span>
                </a>
                <a href="/admin/users" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition">
                    <i class="fas fa-user-cog w-5"></i>
                    <span>Users</span>
                </a>
                <a href="/admin/logout" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-red-600/20 text-red-400 transition mt-8">
                    <i class="fas fa-sign-out-alt w-5"></i>
                    <span>Logout</span>
                </a>
            </nav>
        </aside>
        
        <!-- Main Content -->
        <main class="ml-64 flex-1 p-8 overflow-y-auto">
            <div class="flex justify-between items-center mb-8">
                <div>
                    <h2 class="text-3xl font-bold text-white">Dashboard</h2>
                    <p class="text-slate-400">Welcome back, <%= admin ? admin.name : 'Admin' %></p>
                </div>
                <div class="flex items-center gap-4">
                    <span class="text-slate-400"><i class="fas fa-user-circle text-2xl"></i> <%= admin ? admin.name : 'Admin' %></span>
                </div>
            </div>
            
            <!-- Stats Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-slate-400 text-sm">Total Mentors</p>
                            <h3 class="text-3xl font-bold text-white mt-1"><%= stats.totalMentors || 0 %></h3>
                        </div>
                        <div class="w-12 h-12 bg-indigo-600/20 rounded-lg flex items-center justify-center">
                            <i class="fas fa-users text-indigo-500 text-xl"></i>
                        </div>
                    </div>
                </div>
                
                <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-slate-400 text-sm">Pending Approvals</p>
                            <h3 class="text-3xl font-bold text-yellow-400 mt-1"><%= stats.pendingMentors || 0 %></h3>
                        </div>
                        <div class="w-12 h-12 bg-yellow-600/20 rounded-lg flex items-center justify-center">
                            <i class="fas fa-clock text-yellow-500 text-xl"></i>
                        </div>
                    </div>
                </div>
                
                <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-slate-400 text-sm">Approved Mentors</p>
                            <h3 class="text-3xl font-bold text-emerald-400 mt-1"><%= stats.approvedMentors || 0 %></h3>
                        </div>
                        <div class="w-12 h-12 bg-emerald-600/20 rounded-lg flex items-center justify-center">
                            <i class="fas fa-check-circle text-emerald-500 text-xl"></i>
                        </div>
                    </div>
                </div>
                
                <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-slate-400 text-sm">Rejected Mentors</p>
                            <h3 class="text-3xl font-bold text-red-400 mt-1"><%= stats.rejectedMentors || 0 %></h3>
                        </div>
                        <div class="w-12 h-12 bg-red-600/20 rounded-lg flex items-center justify-center">
                            <i class="fas fa-times-circle text-red-500 text-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Quick Actions -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
                    <h4 class="text-lg font-semibold text-white mb-4">Quick Actions</h4>
                    <div class="space-y-3">
                        <a href="/admin/mentors?status=pending" class="flex items-center gap-3 p-3 bg-slate-800/50 rounded-lg hover:bg-slate-800 transition">
                            <div class="w-10 h-10 bg-yellow-600/20 rounded-lg flex items-center justify-center">
                                <i class="fas fa-user-check text-yellow-500"></i>
                            </div>
                            <div>
                                <p class="text-white font-medium">Review Pending Mentors</p>
                                <p class="text-sm text-slate-400"><%= stats.pendingMentors || 0 %> pending approvals</p>
                            </div>
                            <i class="fas fa-chevron-right text-slate-600 ml-auto"></i>
                        </a>
                        <a href="/admin/mentors" class="flex items-center gap-3 p-3 bg-slate-800/50 rounded-lg hover:bg-slate-800 transition">
                            <div class="w-10 h-10 bg-indigo-600/20 rounded-lg flex items-center justify-center">
                                <i class="fas fa-list text-indigo-500"></i>
                            </div>
                            <div>
                                <p class="text-white font-medium">View All Mentors</p>
                                <p class="text-sm text-slate-400">Manage mentor profiles</p>
                            </div>
                            <i class="fas fa-chevron-right text-slate-600 ml-auto"></i>
                        </a>
                    </div>
                </div>
            </div>
        </main>
    </div>
    
    <script src="/admin/js/admin.js"></script>
</body>
</html>